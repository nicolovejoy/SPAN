# InfluxDB endpoint exposed via Cloudflare tunnel (e.g. https://influx.your-domain.com)
# In local dev, you can point directly at the Pi's LAN address.
INFLUX_URL=

# Influx auth (read-only token recommended)
INFLUX_TOKEN=
INFLUX_ORG=home
INFLUX_BUCKET=span

# Cloudflare Access service token (only needed when INFLUX_URL is gated)
# Generate at https://one.dash.cloudflare.com/ → Access → Service Auth → Service Tokens
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
